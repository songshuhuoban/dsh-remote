{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dsh-remote",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The web console is served as static assets; only relay paths reach the Worker.
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health", "/github/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }],
  "vars": {
    // "disabled" | "enabled" | "invite" (needs the REGISTRATION_INVITE_CODE secret)
    "REGISTRATION": "invite",
    "ALLOWED_ORIGINS": "",
    "EVENT_RETENTION_DAYS": "7",
    // GitHub App "DSH Remote" (sign-in and read-only repositories); docs/deploy-cloudflare.md.
    // GITHUB_APP_CLIENT_SECRET and GITHUB_TOKEN_ENCRYPTION_KEY are Worker secrets.
    "GITHUB_APP_CLIENT_ID": "Iv23liTiFdNGXZP4IQYM",
    "GITHUB_APP_SLUG": "dsh-remote",
    "GITHUB_CALLBACK_URL": "https://dsh.sqmem.top/github/callback"
  },
  "routes": [{ "pattern": "dsh.sqmem.top", "custom_domain": true }],
  "observability": { "enabled": true }
}
