{
  "name": "@dsh-remote/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "cf:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cf:dev": "wrangler dev -c cloudflare/wrangler.jsonc",
    "cf:deploy": "wrangler deploy -c cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@dsh-remote/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "wrangler": "4"
  }
}
