{
  "name": "@dsh-remote/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:browser": "playwright test -c e2e/playwright.config.ts",
    "test:browser:runtime": "playwright test -c e2e/playwright.runtime.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.2",
    "vite": "latest",
    "vitest": "latest",
    "ws": "^8.22.0"
  }
}
